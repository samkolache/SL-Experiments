{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "sam-sandbox": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss",
              {
                "input": "src/themes/alpaca.scss",
                "bundleName": "theme-alpaca",
                "inject": false
              },
              {
                "input": "src/themes/external.scss",
                "bundleName": "theme-external",
                "inject": false
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "."
              ]
            },
            "scripts": [],
            "baseHref": "/sams-tests/"
          },
          "configurations": {
            "local": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.5MB",
                  "maximumError": "3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "65kB",
                  "maximumError": "70kb"
                }
              ],
              "baseHref": "/sams-tests/",
              "outputHashing": "media",
              "sourceMap": true,
              "optimization": false,
              "extractLicenses": false
            },
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.5MB",
                  "maximumError": "3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "65kB",
                  "maximumError": "70kb"
                }
              ],
              "outputHashing": "all",
              "baseHref": "/sams-tests/",
              "optimization": {
                "styles": {
                  "inlineCritical": false
                }
              },
              "sourceMap": {
                "scripts": true,
                "hidden": true
              },
              "extractLicenses": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "media",
              "baseHref": "/sams-tests/"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "local": {
              "buildTarget": "sam-sandbox:build:local"
            },
            "production": {
              "buildTarget": "sam-sandbox:build:production"
            },
            "development": {
              "buildTarget": "sam-sandbox:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss",
              {
                "input": "src/themes/alpaca.scss",
                "bundleName": "theme-alpaca",
                "inject": false
              },
              {
                "input": "src/themes/external.scss",
                "bundleName": "theme-external",
                "inject": false
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "."
              ]
            },
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
