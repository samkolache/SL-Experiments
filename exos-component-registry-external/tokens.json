{
  "id": "exos-tokens",
  "component": "Tokens",
  "description": "Foundational design tokens for @exos/exos-theme-external (Bootstrap 5). Source of truth for colors, spacing, type scale and breakpoints. The drift-check script validates bootstrap-generated color classes against `themeColors`/`diagramColors` here. NOTE: this theme layers a 'new theme' on top — many semantic colors resolve at runtime via CSS custom properties (var(--exos-new-*)) defined in root-new-theme.scss; the base hex values below come from _variables.scss.",
  "source": {
    "package": "@exos/exos-theme-external",
    "scss": ["src/scss/_variables.scss", "src/scss/_variable-new-theme.scss", "src/main.scss"]
  },
  "themeColors": {
    "primary": "#066dce",
    "secondary": "#4a5c6c",
    "dark": "#0a2845",
    "success": "#1c7c35",
    "danger": "#cc3115",
    "warning": "#f9a824"
  },
  "tints": {
    "primary-light": "#e4f2fe",
    "primary-lighter": "#eff7fe",
    "success-light": "#effde1",
    "success-lighter": "#f6fde5",
    "danger-light": "#feeae6",
    "danger-lighter": "#fff0f0",
    "warning-light": "#feeed3",
    "warning-lighter": "#fff4e1",
    "secondary-light": "#f0f2f5",
    "secondary-lighter": "#f7f8fa"
  },
  "grays": {
    "gray-1": "#66747f",
    "gray-2": "#85919e",
    "gray-3": "#c6ccd2",
    "gray-4": "#f0f2f5",
    "gray-5": "#f7f8fa"
  },
  "diagramColors": {
    "salmon": "#e57272",
    "pink": "#f06292",
    "skyblue": "#169cdf",
    "periwinkle": "#7986cb",
    "orange": "#e2780d",
    "green": "#61a435",
    "violet": "#9575cd",
    "orchid": "#ba68c8",
    "brown": "#a1887f",
    "tealGreen": "#4FA29E"
  },
  "themeLabels": {
    "description": "Semantic label colors (base + light target) from the $theme-labels map — new to this theme vs alpaca.",
    "success": { "base": "#1C7C35", "target": "#F6FDE5" },
    "primary": { "base": "#066DCE", "target": "#EFF7FE" },
    "danger": { "base": "#CC3115", "target": "#FFF0F0" },
    "neutral": { "base": "#304258", "target": "#F0F2F5" },
    "warning": { "base": "#734A06", "target": "#FFF4E1" }
  },
  "breakpoints": {
    "xs": "0",
    "sm": "576px",
    "md": "768px",
    "lg": "992px",
    "xl": "1280px",
    "xxl": "1368px"
  },
  "spacers": {
    "description": "Bootstrap spacing scale (m-*, p-*, gap-*) remapped to these rem values.",
    "0": "0",
    "1": "0.375rem",
    "2": "0.5625rem",
    "3": "0.75rem",
    "4": "0.9375rem",
    "5": "1.125rem",
    "6": "1.5rem",
    "7": "1.875rem",
    "8": "2.25rem"
  },
  "fontSizes": {
    "description": "New-theme font-size scale. Each maps to BOTH a t-* and an fs-* utility class (e.g. .t-10 / .fs-10).",
    "xx-sm": { "rem": "0.625rem", "classes": ["t-10", "fs-10"] },
    "x-sm": { "rem": "0.75rem", "classes": ["t-12", "fs-12"] },
    "sm": { "rem": "0.875rem", "classes": ["t-14", "fs-14"] },
    "md": { "rem": "1rem", "classes": ["t-16", "fs-16"] },
    "lg": { "rem": "1.125rem", "classes": ["t-18", "fs-18"] },
    "x-lg": { "rem": "1.25rem", "classes": ["t-20", "fs-20"] },
    "xx-lg": { "rem": "1.5rem", "classes": ["t-24", "fs-24"] }
  },
  "radius": {
    "description": "New-theme corner-radius scale with utility classes. (alpaca had square corners; this theme rounds.)",
    "sm": { "value": "0.25rem", "class": "radius-4" },
    "md": { "value": "0.5rem", "class": "radius-8" },
    "lg": { "value": "0.75rem", "class": "radius-12" },
    "round": { "value": "100%", "class": "radius-100" }
  },
  "dialogWidths": {
    "description": "Dialog width utilities (.dialog-*) and the modal size map.",
    "sm": "300px",
    "md": "480px",
    "lg": "800px",
    "x-lg": "1140px",
    "xx-lg": "1400px"
  },
  "gradients": {
    "description": "Gradient backgrounds .bg-gradient-01 … .bg-gradient-11 (CSS vars --exos-new-gradient-NN).",
    "classes": ["bg-gradient-01", "bg-gradient-02", "bg-gradient-03", "bg-gradient-04", "bg-gradient-05", "bg-gradient-06", "bg-gradient-07", "bg-gradient-08", "bg-gradient-09", "bg-gradient-10", "bg-gradient-11"]
  },
  "componentTokens": {
    "button": { "borderRadius": "0.25rem", "textTransform": "uppercase", "fontWeight": 700, "fontSize": "0.75rem", "letterSpacing": "0.075rem", "paddingY": "0.63rem", "paddingX": "1.5rem", "gap": "0.5rem" },
    "input": { "borderRadius": "0", "height": "2.25rem", "fontSize": "0.875rem", "borderColor": "#85919e", "focusBorderColor": "#066dce", "disabledBg": "#f0f2f5" },
    "card": { "borderRadius": "0", "borderWidth": "0", "spacerX": "1.125rem", "spacerY": "0.9375rem", "capBg": "#f0f2f5" },
    "modal": { "borderRadius": "0", "borderWidth": "0", "innerPadding": "1.125rem", "contentBg": "#ffffff" },
    "alert": { "borderRadius": "0", "borderWidth": "0", "paddingY": "0.5625rem", "paddingX": "1.125rem" }
  },
  "shadows": {
    "box-shadow": "0px 1px 3px rgba(10, 40, 69, 0.25)",
    "focus-ring": "0 0 0 1px #fff, 0 0 0 3px rgba(59, 153, 252, 0.7)"
  }
}
